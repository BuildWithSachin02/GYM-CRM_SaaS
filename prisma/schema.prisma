// Prisma schema — Gym Management + CRM SaaS (King's Gym)
// Classic Prisma 6.19.3 workflow. PostgreSQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums (PostgreSQL native enums)
// ---------------------------------------------------------------------------

enum OrgStatus {
  ACTIVE
  SUSPENDED
}

enum LocationStatus {
  ACTIVE
  INACTIVE
}

enum UserRole {
  OWNER
  ADMIN
  RECEPTIONIST
  TRAINER
}

enum UserStatus {
  ACTIVE
  DEACTIVATED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum PlanInterval {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PAUSED
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
}

enum PaymentStatus {
  RECORDED
  VOIDED
  REFUNDED
}

enum AttendanceSource {
  MANUAL
  QR_SESSION
}

enum AttendanceRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeadStage {
  NEW
  CONTACTED
  VISIT_SCHEDULED
  VISIT_DONE
  CONVERTED
  LOST
}

enum LeadSource {
  WEBSITE
  INSTAGRAM
  FACEBOOK
  WHATSAPP
  GOOGLE
  WALK_IN
  MANUAL
}

enum LeadActivityType {
  CALL
  WHATSAPP
  MESSAGE
  VISIT
  NOTE
  FOLLOW_UP
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
}

enum NotificationType {
  MEMBERSHIP_EXPIRING
  MEMBERSHIP_EXPIRED
  NEW_LEAD
  TASK_ASSIGNED
  TASK_OVERDUE
  APPOINTMENT_REMINDER
  PAYMENT_RECORDED
  LEAD_CONVERTED
  ATTENDANCE_REQUEST
}

// ---------------------------------------------------------------------------
// Tenancy backbone
// ---------------------------------------------------------------------------

model Organization {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  logoUrl   String?
  phone     String?
  email     String?
  address   String?
  city      String?
  state     String?
  country   String?
  timezone  String    @default("Asia/Kolkata")
  currency  String    @default("INR")
  status    OrgStatus @default(ACTIVE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  locations      GymLocation[]
  users          User[]
  members        Member[]
  trainers       Trainer[]
  plans          MembershipPlan[]
  memberships    Membership[]
  payments       Payment[]
  checkIns       CheckIn[]
  qrSessions     QRSession[]
  leads          Lead[]
  leadActivities LeadActivity[]
  appointments   Appointment[]
  tasks              Task[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  attendanceRequests AttendanceRequest[]
  memberDevices      MemberDevice[]
  userPermissions    UserPermission[]

  @@index([status])
}

model GymLocation {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name           String
  address        String?
  city           String?
  state          String?
  timezone       String         @default("Asia/Kolkata")
  status         LocationStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  members      Member[]      @relation("MemberLocations")
  checkIns     CheckIn[]
  qrSessions   QRSession[]
  appointments Appointment[]
  leads        Lead[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([organizationId, status])
}

// ---------------------------------------------------------------------------
// Staff / users
// ---------------------------------------------------------------------------

model User {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name           String
  email          String       @unique
  // Optional organization-scoped display/alias handle. The login identifier is
  // ALWAYS `email`; username is never used for authentication. Unique per org
  // (multiple NULLs are allowed by the DB).
  username       String?
  passwordHash   String
  phone          String?
  role           UserRole     @default(RECEPTIONIST)
  status         UserStatus   @default(ACTIVE)
  // Bumped on deactivation, password change/reset, role change and significant
  // permission changes. The signed session cookie embeds this value; a stale
  // session (lower version) is rejected on the next request, actively revoking
  // existing sessions without a session table.
  sessionVersion Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  trainer           Trainer?
  recordedPayments  Payment[]      @relation("RecordedPayments")
  createdQrSessions QRSession[]    @relation("CreatedQrSessions")
  ownedLeads        Lead[]         @relation("OwnedLeads")
  staffAppointments Appointment[]  @relation("StaffAppointments")
  assignedTasks     Task[]         @relation("TaskAssignee")
  createdTasks              Task[]               @relation("TaskCreator")
  leadActivities            LeadActivity[]
  notifications             Notification[]
  auditLogs                 AuditLog[]
  approvedAttendanceRequests AttendanceRequest[]  @relation("ApprovedAttendanceRequests")
  rejectedAttendanceRequests AttendanceRequest[]  @relation("RejectedAttendanceRequests")
  userPermissions           UserPermission[]

  @@unique([organizationId, username])
  @@index([organizationId])
  @@index([organizationId, role])
  @@index([organizationId, status])
}

// ---------------------------------------------------------------------------
// Per-user permission overrides (Users & Access Control)
//
// Role defaults are the baseline; these rows override them per user. A row
// stores granted=true/false for a specific permission key. Precedence:
// OWNER full-access > explicit row > role default. Permission keys are
// validated server-side against the catalog in src/lib/permissions.ts — unknown
// client-provided strings are rejected before any row is written.
// ---------------------------------------------------------------------------

model UserPermission {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission     String
  granted        Boolean
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, userId, permission])
  @@index([organizationId])
  @@index([organizationId, userId])
}

model Trainer {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userId         String       @unique
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio            String?
  specialties    Json?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  members      Member[]      @relation("AssignedTrainer")
  appointments Appointment[]

  @@index([organizationId])
  @@index([organizationId, active])
}

// ---------------------------------------------------------------------------
// Members
// ---------------------------------------------------------------------------

model Member {
  id                    String       @id @default(uuid())
  organizationId        String
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  primaryLocationId     String?
  location              GymLocation? @relation("MemberLocations", fields: [primaryLocationId], references: [id], onDelete: SetNull)
  firstName             String
  lastName              String
  // Org-scoped, human-facing identifier ("MEM-0001"). Display only — the
  // UUID `id` remains the canonical identity and every FK stays a UUID.
  memberCode            String
  phone                 String
  email                 String?
  gender                Gender?
  dateOfBirth           DateTime?
  address               String?
  emergencyContactName  String?
  emergencyContactPhone String?
  trainerId             String?
  trainer               Trainer?     @relation("AssignedTrainer", fields: [trainerId], references: [id], onDelete: SetNull)
  signupSource          LeadSource?
  status                MemberStatus @default(ACTIVE)
  notes                 String?
  // Optional bcrypt hash of the member's numeric check-in PIN (QR attendance).
  // Never stored in plain text, never encoded in a QR, never included in
  // attendance records. Members authenticate with phone + PIN on the QR page;
  // the server derives their identity from the resulting signed session.
  pinHash               String?
  deletedAt             DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  memberships    Membership[]
  payments       Payment[]
  checkIns       CheckIn[]
  convertedLeads Lead[]
  tasks          Task[]        @relation("TaskMember")
  appointments   Appointment[]
  attendanceRequests AttendanceRequest[]
  memberDevices  MemberDevice[]

  @@unique([organizationId, email])
  // Phone is deliberately NOT org-unique: family members may share a number.
  // Same-name + same-phone members produce a STRONG duplicate WARNING (never
  // a block) at the application layer.
  @@unique([organizationId, memberCode])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, trainerId])
  @@index([organizationId, primaryLocationId])
  // Covers: member list (org + deletedAt + createdAt desc), totalMembers
  // count (org + deletedAt), recentMembers (org + deletedAt + createdAt desc)
  @@index([organizationId, deletedAt, createdAt])
}

// ---------------------------------------------------------------------------
// Plans & memberships
// ---------------------------------------------------------------------------

model MembershipPlan {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name            String
  billingInterval PlanInterval
  priceMinor      Int
  currency        String       @default("INR")
  durationDays    Int
  description     String?
  active          Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  memberships     Membership[]
  interestedLeads Lead[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([organizationId, active])
}

model Membership {
  id                  String           @id @default(uuid())
  organizationId      String
  organization        Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  memberId            String
  member              Member           @relation(fields: [memberId], references: [id], onDelete: Restrict)
  planId              String
  plan                MembershipPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)
  status              MembershipStatus @default(ACTIVE)
  startDate           DateTime
  endDate             DateTime
  amountMinor         Int
  notes               String?
  // The org-local commitment day the owner expects this membership to be
  // paid in full by. NEVER revenue: it only drives the derived PENDING/OVERDUE
  // outstanding status. Money is always the RECORDED payment rows.
  expectedPaymentDate DateTime?
  renewsAutomatically Boolean          @default(false)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  payments Payment[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, memberId])
  @@index([organizationId, planId])
  @@index([organizationId, endDate])
  // Covers: expiring memberships (org + status + endDate range),
  // sidebar membership count (org + status), lifecycle stats (org)
  @@index([organizationId, status, endDate])
  // App-layer business rule: at most one ACTIVE/PAUSED membership may
  // overlap a given period. The D-08 unique index was removed; this index
  // backs the overlap check in the membership actions.
  @@index([organizationId, memberId, status, startDate, endDate])
}

// ---------------------------------------------------------------------------
// Payments (manual only, integer minor units)
// ---------------------------------------------------------------------------

model Payment {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  memberId       String
  member         Member        @relation(fields: [memberId], references: [id], onDelete: Restrict)
  membershipId   String?
  membership     Membership?   @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  amountMinor    Int
  currency       String        @default("INR")
  method         PaymentMethod
  status         PaymentStatus @default(RECORDED)
  reference      String?
  paymentDate    DateTime      @default(now())
  recordedById   String
  recordedBy     User          @relation("RecordedPayments", fields: [recordedById], references: [id], onDelete: Restrict)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId])
  @@index([organizationId, memberId])
  @@index([organizationId, membershipId])
  @@index([organizationId, paymentDate])
  @@index([organizationId, method])
  // Covers: today's revenue (org + status + paymentDate range),
  // revenue trend 30d (org + status + paymentDate gte),
  // recent payments (org + status + paymentDate desc)
  @@index([organizationId, status, paymentDate])
}

// ---------------------------------------------------------------------------
// Attendance (manual + QR) — one check-in per member per dayKey
// ---------------------------------------------------------------------------

model CheckIn {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  memberId       String
  member         Member           @relation(fields: [memberId], references: [id], onDelete: Restrict)
  locationId     String?
  location       GymLocation?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  qrSessionId    String?
  qrSession      QRSession?       @relation(fields: [qrSessionId], references: [id], onDelete: Restrict)
  source         AttendanceSource @default(MANUAL)
  dayKey         String // YYYY-MM-DD (local) — used for duplicate prevention
  checkedInAt    DateTime         @default(now())
  createdAt      DateTime         @default(now())

  attendanceRequest AttendanceRequest?

  @@unique([organizationId, memberId, dayKey])
  @@index([organizationId])
  @@index([organizationId, memberId])
  @@index([organizationId, locationId, checkedInAt])
  // Covers: today's attendance count (org + dayKey), attendance page list
  // (org + dayKey ordered by checkedInAt desc), attendance trend groupBy
  @@index([organizationId, dayKey])
}

model QRSession {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  locationId     String
  location       GymLocation  @relation(fields: [locationId], references: [id], onDelete: Restrict)
  label          String?
  tokenHash      String       @unique // only the hash is ever stored
  expiresAt      DateTime
  revokedAt      DateTime?
  createdById    String
  createdBy      User         @relation("CreatedQrSessions", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt      DateTime     @default(now())

  checkIns CheckIn[]
  attendanceRequests AttendanceRequest[]

  @@index([organizationId])
  @@index([organizationId, expiresAt])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Trusted devices (QR attendance convenience) — NOT authorization
// ---------------------------------------------------------------------------

model MemberDevice {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  memberId       String
  member         Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  // SHA-256 hex digest of the raw cookie token. The raw token lives only in the
  // browser's secure HttpOnly cookie (path=/attendance/qr); the server never
  // stores it, never logs it, and never exports it.
  tokenHash      String   @unique
  lastUsedAt     DateTime @default(now()) @updatedAt
  revokedAt      DateTime?
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([organizationId, memberId])
  @@index([organizationId, revokedAt])
}

// ---------------------------------------------------------------------------
// Pending QR attendance requests (PENDING/APPROVED/REJECTED)
//
// A request is NEVER a completed check-in. It is only the reviewable record of
// a member scanning a valid QR while their membership does not cover the scan
// day because of a genuine business state: EXPIRED / CANCELLED / PAUSED /
// UPCOMING membership, or a future start. An APPROVED request is converted
// into a real CheckIn (checkedInAt = the original requestedAt, dayKey = the
// original attempt day) so reports/analytics keep reading only CheckIn rows.
//
// Member-device identification is only a convenience: the same server-side
// membership/eligibility validation runs on EVERY scan, remembered or not.
// ---------------------------------------------------------------------------

model AttendanceRequest {
  id              String                  @id @default(uuid())
  organizationId  String
  organization    Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  memberId        String
  member          Member                  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  qrSessionId     String?
  qrSession       QRSession?              @relation(fields: [qrSessionId], references: [id], onDelete: SetNull)
  source          AttendanceSource        @default(QR_SESSION)
  status          AttendanceRequestStatus @default(PENDING)
  dayKey          String // YYYY-MM-DD of the attempt, in the org's timezone
  requestedAt     DateTime                @default(now())
  approvedAt      DateTime?
  approvedById    String?
  approvedBy      User?                   @relation("ApprovedAttendanceRequests", fields: [approvedById], references: [id], onDelete: SetNull)
  rejectedAt      DateTime?
  rejectedById    String?
  rejectedBy      User?                   @relation("RejectedAttendanceRequests", fields: [rejectedById], references: [id], onDelete: SetNull)
  rejectionReason String?
  checkInId       String?                 @unique
  checkIn         CheckIn?                @relation(fields: [checkInId], references: [id], onDelete: SetNull)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  // Anti-spam: at most ONE attendance request per member per org-local day,
  // regardless of status. Repeated scans of the same member face the record
  // that already exists instead of stacking duplicate requests.
  @@unique([organizationId, memberId, dayKey])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, memberId])
  @@index([organizationId, requestedAt])
}

// ---------------------------------------------------------------------------
// Leads / CRM
// ---------------------------------------------------------------------------

model Lead {
  id                String          @id @default(uuid())
  organizationId    String
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  locationId        String?
  location          GymLocation?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  name              String
  phone             String
  email             String?
  source            LeadSource
  sourceDetail      String?
  stage             LeadStage       @default(NEW)
  interestedPlanId  String?
  interestedPlan    MembershipPlan? @relation(fields: [interestedPlanId], references: [id], onDelete: SetNull)
  ownerUserId       String?
  ownerUser         User?           @relation("OwnedLeads", fields: [ownerUserId], references: [id], onDelete: SetNull)
  followUpDate      DateTime?
  notes             String?
  convertedMemberId String?         @unique
  convertedMember   Member?         @relation(fields: [convertedMemberId], references: [id], onDelete: SetNull)
  convertedAt       DateTime?
  deletedAt         DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  leadActivities LeadActivity[]
  appointments   Appointment[]
  tasks          Task[]         @relation("TaskLead")

  @@unique([organizationId, email])
  @@unique([organizationId, phone])
  @@index([organizationId])
  @@index([organizationId, stage])
  @@index([organizationId, source])
  @@index([organizationId, ownerUserId])
  @@index([organizationId, followUpDate])
  // Covers: new-lead count (org + deletedAt + stage), pending follow-ups
  // (org + deletedAt + stage + followUpDate range), lead pipeline groupBy
  // (org + deletedAt), today's follow-up list (org + deletedAt + stage +
  // followUpDate range)
  @@index([organizationId, deletedAt, stage, followUpDate])
}

model LeadActivity {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  leadId         String
  lead           Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type           LeadActivityType
  body           String
  createdById    String?
  createdBy      User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  activityDate   DateTime         @default(now())
  createdAt      DateTime         @default(now())

  @@index([organizationId])
  @@index([organizationId, leadId])
}

// ---------------------------------------------------------------------------
// Appointments
// ---------------------------------------------------------------------------

model Appointment {
  id             String            @id @default(uuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  locationId     String?
  location       GymLocation?      @relation(fields: [locationId], references: [id], onDelete: SetNull)
  memberId       String?
  member         Member?           @relation(fields: [memberId], references: [id], onDelete: SetNull)
  leadId         String?
  lead           Lead?             @relation(fields: [leadId], references: [id], onDelete: SetNull)
  trainerId      String?
  trainer        Trainer?          @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  staffId        String?
  staff          User?             @relation("StaffAppointments", fields: [staffId], references: [id], onDelete: SetNull)
  startsAt       DateTime
  endsAt         DateTime
  status         AppointmentStatus @default(SCHEDULED)
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([organizationId])
  @@index([organizationId, startsAt])
  @@index([organizationId, status])
  @@index([organizationId, memberId])
  @@index([organizationId, leadId])
  @@index([organizationId, trainerId])
  // Covers: today's appointments (org + startsAt range), next-week
  // appointments (org + status + startsAt range), upcoming appointments
  // count (org + status + startsAt gte), appointments page (org + startsAt)
  @@index([organizationId, status, startsAt])
}

// ---------------------------------------------------------------------------
// Tasks / follow-ups
// ---------------------------------------------------------------------------

model Task {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  title          String
  description    String?
  dueDate        DateTime
  status         TaskStatus   @default(TODO)
  assigneeId     String?
  assignee       User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById    String?
  createdBy      User?        @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  memberId       String?
  member         Member?      @relation("TaskMember", fields: [memberId], references: [id], onDelete: SetNull)
  leadId         String?
  lead           Lead?        @relation("TaskLead", fields: [leadId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, assigneeId])
  @@index([organizationId, dueDate])
  // Covers: overdue tasks (org + status IN + dueDate lt ordered by dueDate
  // asc), pending-task count (org + status IN), tasks page
  // (org + status + dueDate order)
  @@index([organizationId, status, dueDate])
}

// ---------------------------------------------------------------------------
// Notifications (in-app inbox only)
// ---------------------------------------------------------------------------

model Notification {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           NotificationType
  title          String
  body           String?
  link           String?
  isRead         Boolean          @default(false)
  createdAt      DateTime         @default(now())

  @@index([organizationId])
  @@index([organizationId, userId, isRead])
  @@index([organizationId, isRead])
}

// ---------------------------------------------------------------------------
// Audit log (append-only)
// ---------------------------------------------------------------------------

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actorUserId    String?
  actorUser      User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action         String
  entityType     String
  entityId       String?
  before         Json?
  after          Json?
  ip             String?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
}
