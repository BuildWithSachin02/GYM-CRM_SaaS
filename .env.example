# Local development environment (see .env for real values; .env is gitignored)
# Prisma / PostgreSQL connection string
DATABASE_URL="postgresql://gym:gym_dev_password@localhost:5432/gym_crm"

# Supabase pooler (optional):
# DATABASE_URL must be the TRANSACTION-mode pooler (port 6543) with
# pgbouncer=true so Prisma's pool releases connections per transaction.
#   DATABASE_URL="postgresql://[DB-USER].[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"
# DIRECT_URL is used solely by `prisma migrate` (schema.datasource.directUrl)
# and should be the session-mode pooler (port 5432) / direct connection.
#   DIRECT_URL="postgresql://[DB-USER].[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Secret used to sign session cookies. Generate a strong random value in production:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-long-random-string"

# Password used for seeded demo accounts (prisma db seed). Min 8 characters.
SEED_OWNER_PASSWORD="replace-with-a-demo-password"