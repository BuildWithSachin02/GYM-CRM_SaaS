# Local development environment (see .env for real values; .env is gitignored)
# Prisma / PostgreSQL connection string
DATABASE_URL="postgresql://gym:gym_dev_password@localhost:5432/gym_crm"

# Secret used to sign session cookies. Generate a strong random value in production:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-long-random-string"

# Password used for seeded demo accounts (prisma db seed). Min 8 characters.
SEED_OWNER_PASSWORD="replace-with-a-demo-password"